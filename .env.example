# Copy to .env and fill in the two provider URLs; everything else has a
# working default, and Compose sets the connection strings.

# HTTP_ADDR=:8080
# DATABASE_URL=postgres://search:search@localhost:5432/search?sslmode=disable

# Optional. Without Redis there is no cache, no ingestion lock and no rate limit.
# REDIS_ADDR=localhost:6379

# Enables POST /api/v1/ingest when set.
ADMIN_API_KEY=dev-admin-key

# Required: the provider endpoints given with the brief. They are kept out of
# the repository on purpose.
PROVIDER1_URL=
PROVIDER2_URL=

# INGEST_INTERVAL=5m
# INGEST_TIMEOUT=1h            # bounds one run; what was stored before it stays

# Paging and pace per provider. The defaults allow a million items each, which
# takes about half an hour at five requests a second.
# PROVIDER_PAGE_SIZE=100
# PROVIDER_MAX_PAGES=10000     # reaching it is reported as an error
# PROVIDER_REQUESTS_PER_SECOND=5

# CACHE_TTL=1m
# RATE_LIMIT_PER_MINUTE=120   # per client IP; 0 turns it off
# LOG_LEVEL=info              # debug, info, warn or error
